# App
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql://enigma:enigma_secret@localhost:5432/client_portal

# Clerk Auth
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# Storage (MinIO defaults for local dev)
STORAGE_BUCKET=client-portal
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_EXTERNAL_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_PUBLIC_URL=http://localhost:9000/client-portal

# Email (Resend — optional)
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@enigma-cube.com
# Inbox for alerts when a client signs, pays or books the kickoff call
ADMIN_NOTIFICATION_EMAIL=info@enigma-cube.com

# AI (Groq — free tier, get key at console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# CORS
FRONTEND_URL=http://localhost:3000
