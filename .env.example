# ──────────────────────────────────────────────────────────
# Enigma-Cube Client Portal — Root Environment Variables
# Copy this file to .env and fill in your values.
# Only TWO values are required to get started locally:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY
# ──────────────────────────────────────────────────────────

# ── Clerk Auth (required) ──────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
# Use your DEVELOPMENT instance keys — pk_live_/sk_live_ are pinned to your
# production domain and are rejected on localhost.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# The "Frontend API URL" on the same API Keys page.
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

# ── AI — Groq (free tier) ──────────────────────────────────
# Sign up free at https://console.groq.com
GROQ_API_KEY=gsk_...

# ── App Config ─────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ── Email (Resend — optional) ──────────────────────────────
# Sign up free at https://resend.com (3,000 emails/month free)
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@enigma-cube.com

# ── Storage (optional) ─────────────────────────────────────
# There is no object storage in the local stack. Leave these unset and file
# uploads return a 503; set them to use Cloudflare R2 or S3.
# Local: MinIO runs automatically via docker-compose (no config needed).
# Production: set these to your Cloudflare R2 or AWS S3 values.
# STORAGE_BUCKET=client-portal
# STORAGE_ENDPOINT=https://accountid.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_access_key
# STORAGE_SECRET_KEY=your_secret_key
# STORAGE_PUBLIC_URL=https://your-r2-public-url.com
